---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedProjects from '../components/projects/FeaturedProjects.astro';
import { getCommitsSeed } from '../utils/iceberg';
import Dashboard from '../components/Dashboard.astro';

// Server-side seed: the latest commits snapshot from KV, inlined into the HTML
// so first-time visitors get instant paint. Refresh happens in the background
// (waitUntil) when stale — never blocking this render.
const commitsSeed = await getCommitsSeed(Astro.locals);
---

<Layout title="Home" description="Welcome to my portfolio website">
	<Hero
		headline="Hello! I'm Michael."
		subheadline="Developer and Student"
		bio="I'm a developer going into university and I'm interested in systems development and data science. I also enjoy snowboarding."
		profileImage="/assets/profile-picture.jpg"
		socialLinks={[
			{ label: 'GitHub', url: 'https://github.com/penqguin' },
			{ label: 'LinkedIn', url: 'https://linkedin.com/in/michaelpanmaddison' },
		]}
	/>
	
	<FeaturedProjects />
	
	<Dashboard commitsSeed={commitsSeed} />
</Layout>

